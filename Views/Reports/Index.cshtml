@model List<WasteEntry>
@{ViewData["Title"]="Reports";var groups=Model.GroupBy(x=>x.BusinessType).Select(g=>new{Business=g.Key,Quantity=g.Sum(x=>x.QuantityKg),Value=g.Sum(x=>x.EstimatedValue)}).ToList();}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>📊 Business Reports</h2><a asp-action="ExportCsv" class="btn btn-success">⬇ Export CSV</a></div><div class="row g-3">@foreach(var g in groups){<div class="col-md-6"><div class="card shadow-sm"><div class="card-body"><h4>@g.Business</h4><p class="mb-1">Total waste: <strong>@g.Quantity kg</strong></p><p class="mb-0">Potential recovery: <strong>₹@g.Value</strong></p></div></div></div>}</div><div class="card shadow-sm mt-4"><div class="card-body"><h4>Material Recovery Summary</h4><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Total kg</th><th>Potential value</th></tr></thead><tbody>@foreach(var g in Model.GroupBy(x=>x.Material).OrderByDescending(g=>g.Sum(x=>x.EstimatedValue))){<tr><td>@g.Key</td><td>@g.Sum(x=>x.QuantityKg)</td><td>₹@g.Sum(x=>x.EstimatedValue)</td></tr>}</tbody></table></div></div></div><p class="small text-muted mt-3">Figures are estimates based on user-entered rates; not confirmed sales or environmental impact.</p>