@model List<WasteEntry>
@{ViewData["Title"]="Waste Records";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Waste Records</h2><a asp-action="Create" class="btn btn-success">+ Add Waste</a></div><form method="get" class="input-group mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search material or business"/><button class="btn btn-outline-success">Search</button></form><div class="card shadow-sm"><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>Date</th><th>Material</th><th>Business</th><th>Kg</th><th>Est. Value</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.RecordedAt.ToString("dd MMM yyyy")</td><td>@e.Material</td><td>@e.BusinessType</td><td>@e.QuantityKg</td><td>₹@e.EstimatedValue</td><td><a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">View</a> <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Edit</a> <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this record?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>@if(!Model.Any()){<p class="mt-3">No records found.</p>}