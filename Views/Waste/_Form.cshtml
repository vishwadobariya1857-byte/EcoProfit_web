@model WasteEntry
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="BusinessType" class="form-label"></label><select asp-for="BusinessType" class="form-select"><option>Tailoring</option><option>Plastic Bottle Manufacturing</option></select><span asp-validation-for="BusinessType" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Material" class="form-label"></label><input asp-for="Material" class="form-control" placeholder="e.g. PET plastic scrap"/><span asp-validation-for="Material" class="text-danger"></span></div><div class="col-md-6"><label asp-for="QuantityKg" class="form-label"></label><input asp-for="QuantityKg" type="number" step="0.01" min="0.01" class="form-control"/><span asp-validation-for="QuantityKg" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RatePerKg" class="form-label"></label><input asp-for="RatePerKg" type="number" step="0.01" min="0" class="form-control"/><span asp-validation-for="RatePerKg" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RecordedAt" class="form-label"></label><input asp-for="RecordedAt" type="date" class="form-control"/><span asp-validation-for="RecordedAt" class="text-danger"></span></div><div class="col-md-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div></div><div class="mt-4"><button class="btn btn-success">Save & Analyze</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>