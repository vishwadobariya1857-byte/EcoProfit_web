@model WasteEntry
@{ViewData["Title"]="Smart Analysis";var a=(EcoProfit.Services.WasteAdvice)ViewBag.Advice;}
<div class="d-flex justify-content-between align-items-center mb-4"><h2>🤖 Smart Waste Analysis</h2><a asp-action="Index" class="btn btn-outline-secondary">← Records</a></div><div class="row g-3"><div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body"><h4>Material Information</h4><dl class="row"><dt class="col-5">Business</dt><dd class="col-7">@Model.BusinessType</dd><dt class="col-5">Material</dt><dd class="col-7">@Model.Material</dd><dt class="col-5">Quantity</dt><dd class="col-7">@Model.QuantityKg kg</dd><dt class="col-5">Rate</dt><dd class="col-7">₹@Model.RatePerKg / kg</dd><dt class="col-5">Date</dt><dd class="col-7">@Model.RecordedAt.ToString("dd MMM yyyy")</dd></dl></div></div></div><div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body"><h4>Smart Recommendation</h4><h2 class="text-success">₹@a.EstimatedValue</h2><p class="text-muted">Estimated recovery value</p><p><strong>Priority:</strong> <span class="badge bg-@(a.Priority=="High"?"danger":a.Priority=="Medium"?"warning":"success")">@a.Priority</span></p><p><strong>Suggestion:</strong> @a.Recommendation</p><small class="text-muted">@a.Explanation</small></div></div></div></div><div class="alert alert-info mt-4">ℹ️ This is a rule-based recommendation, not trained AI. Recovery values depend on your entered rates and are not guaranteed profits.</div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Edit Entry</a>