@model List<WasteEntry>
@{ViewData["Title"]="Dashboard";}
<div class="hero p-4 p-md-5 mb-4"><h1>Turn Waste Into Opportunity ♻</h1><p>Track leftover material, estimate potential recovery value and discover reuse options.</p><a asp-controller="Waste" asp-action="Create" class="btn btn-light fw-bold">+ Analyze New Waste</a></div><div class="row g-3 mb-4"><div class="col-md-3"><div class="metric"><small>Waste Entries</small><h2>@Model.Count</h2></div></div><div class="col-md-3"><div class="metric"><small>Total Quantity</small><h2>@ViewBag.TotalKg kg</h2></div></div><div class="col-md-3"><div class="metric"><small>Potential Recovery</small><h2>₹@ViewBag.TotalValue</h2></div></div><div class="col-md-3"><div class="metric"><small>High-Priority Entries</small><h2>@ViewBag.HighCount</h2></div></div></div><div class="card shadow-sm"><div class="card-body"><div class="d-flex justify-content-between align-items-center"><h4>Recent Entries</h4><a asp-controller="Waste" asp-action="Index">View all →</a></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Material</th><th>Business</th><th>Quantity</th><th>Est. Value</th><th></th></tr></thead><tbody>@foreach(var e in Model.Take(5)){<tr><td>@e.Material</td><td>@e.BusinessType</td><td>@e.QuantityKg kg</td><td>₹@e.EstimatedValue</td><td><a asp-controller="Waste" asp-action="Details" asp-route-id="@e.Id">Analyze</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="text-muted">No records yet. Add your first waste entry.</p>}</div></div>